# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PREMIUM_PRICE_ID=price_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RSVP / Ticketing (DJ Maskoff Events) — see supabase-migration-rsvp.sql
# Own base URL — kept separate from NEXT_PUBLIC_APP_URL so RSVP never shares
# a setting with BizzyPlug or the rest of ORCA.
RSVP_APP_URL=https://orcafin.app
RESEND_API_KEY=re_xxx
RSVP_EMAIL_FROM="DJ Maskoff Events <events@your-verified-domain>"
RESEND_WEBHOOK_SECRET=whsec_xxx
RSVP_STAFF_SESSION_SECRET=generate-a-long-random-string
RSVP_OWNER_PASSWORD=
RSVP_EVENT_ADMIN_PASSWORD=
RSVP_DOOR_STAFF_PASSWORD=
RSVP_READONLY_STAFF_PASSWORD=
